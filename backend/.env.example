# ─────────────────────────────────────────
# ローカル開発用（docker-compose.yml が参照）
# cp backend/.env.example backend/.env して使う
# ─────────────────────────────────────────

# DB接続（docker-compose.yml の db サービスに合わせて設定）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app_db
ALLOWED_ORIGINS=http://localhost:3000

# Docker Compose が db サービスを起動するときに使う変数
# docker-compose.yml のデフォルト値（:-postgres / :-app_db）と合わせること
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# 地図関連（任意。未設定なら公開サーバーを使う。詳細: docs/map.md）
# OSRM_BASE_URL=https://router.project-osrm.org
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
